    classDef data fill:#eef2ff,stroke:#4338ca,stroke-width:2px;
    classDef obs fill:#fdf2f8,stroke:#be185d,stroke-width:2px;

    class Api,Lambda,Bedrock aws;
    class Tools,Weather,Internal tool;
    class DDB,S3,KB,Memory data;
    class CW obs;
